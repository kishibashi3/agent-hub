# agent-hub サーバー側の環境変数テンプレ
#
# 使い方:
#   cp .env.example .env
#   # .env を自分の値で書き換える
#   npm run mcp:start    # dotenv が自動で .env を読む

# ===========================================================
# Edition 選択 (必須)
# ===========================================================
#
# community : PAT 認証 + multi-tenant。インターネット公開可
# private   : PAT 認証 + default tenant のみ。完全 LAN 専用
#
# デフォルト値はない。未指定・空文字だと EditionConfigError で起動しない。
# 旧版で trust mode (認証なし) を使っていた場合、trust mode は issue #271 で廃止されている。
# private を指定し、client は GitHub PAT で接続すること。

AGENT_HUB_EDITION=community

# ===========================================================
# 認証モード (省略可)
# ===========================================================
#
# pat : Authorization: Bearer <github-pat> を GitHub API で検証
#
# edition に関係なく pat だけが有効。省略すると pat になる。
# pat 以外の値 (廃止された trust を含む) は EditionConfigError で起動しない。
# AGENT_HUB_AUTH_MODE=trust が残っている場合は削除するか pat にすること。

# AGENT_HUB_AUTH_MODE=pat

# ===========================================================
# Org 制限 (任意、community / private 共通)
# ===========================================================
# 指定すると、その GitHub Org に所属するユーザーのみアクセス可能になる
# 必要 PAT scope: read:org

# AGENT_HUB_GITHUB_ORG=your-org-name

# ===========================================================
# default tenant への外部 access 制御 (CE のみ、任意)
# ===========================================================
# default: 有効 / secure by default
# default tenant への外部 access を operator (@admin) に限定する。
# dev / localhost で「雑談室を開放したい」場合のみ =0 で明示 opt-out。
# PE では効果はなく、設定されていると起動時に WARN が出る。

# AGENT_HUB_DISABLE_DEFAULT_TENANT=0

# ===========================================================
# サーバー設定
# ===========================================================

AGENT_HUB_PORT=3000
AGENT_HUB_DB_PATH=./data/app.db

